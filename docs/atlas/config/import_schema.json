{
  "_comment": "Esquema único de importación CSV/XLSX. Lo usan el validador del navegador (js/csv.js) y el del pipeline (scripts/atlas/import_data.py): una sola regla para ambos.",
  "version": 1,
  "projects": {
    "group_by": "project_id",
    "columns": [
      { "name": "project_id", "type": "string", "required": true, "help": "Identificador estable del proyecto (ej. mosaic-art-santiago). Filas con el mismo id son unidades del mismo proyecto." },
      { "name": "project_name", "type": "string", "required": true },
      { "name": "developer_name", "type": "string", "required": false },
      { "name": "developer_url", "type": "url", "required": false },
      { "name": "address", "type": "string", "required": false, "help": "Calle y número. Si no hay coordenadas, el pipeline la geocodifica." },
      { "name": "commune", "type": "string", "required": true },
      { "name": "neighborhood", "type": "string", "required": false },
      { "name": "latitude", "type": "number", "required": false, "min": -33.7, "max": -33.2 },
      { "name": "longitude", "type": "number", "required": false, "min": -70.9, "max": -70.4 },
      { "name": "geolocation_precision", "type": "enum", "required": false, "enum": ["exacta", "calle", "aproximada", "comuna"] },
      { "name": "unit_id", "type": "string", "required": true },
      { "name": "unit_type", "type": "string", "required": false, "help": "Estudio, 1D1B, 2D2B, 3D2B…" },
      { "name": "bedrooms", "type": "integer", "required": true, "min": 0, "max": 6 },
      { "name": "bathrooms", "type": "number", "required": false, "min": 0, "max": 6 },
      { "name": "useful_area_m2", "type": "number", "required": true, "min": 12, "max": 400 },
      { "name": "total_area_m2", "type": "number", "required": false, "min": 12, "max": 600 },
      { "name": "list_price_uf", "type": "number", "required": false, "min": 300, "max": 100000 },
      { "name": "offer_price_uf", "type": "number", "required": false, "min": 300, "max": 100000 },
      { "name": "bono_pie_pct", "type": "number", "required": false, "min": 0, "max": 20, "help": "Bono pie ofrecido por la inmobiliaria, % del precio." },
      { "name": "pie_installments_max", "type": "number", "required": false, "min": 0, "max": 120, "help": "Cuotas máximas en que la inmobiliaria deja pagar el pie (publicado o confirmado). Vacío = sin datos." },
      { "name": "pie_post_delivery", "type": "bool", "required": false, "help": "'si' si las cuotas del pie pueden seguir después de la entrega (crédito directo de la inmobiliaria)." },
      { "name": "pie_min_upfront_pct", "type": "number", "required": false, "min": 0, "max": 30, "help": "% del precio que exigen al contado en la promesa (si lo informan)." },
      { "name": "parking", "type": "bool", "required": false },
      { "name": "storage", "type": "bool", "required": false },
      { "name": "floor", "type": "integer", "required": false, "min": -3, "max": 80 },
      { "name": "orientation", "type": "string", "required": false },
      { "name": "common_expenses_clp", "type": "number", "required": false, "min": 10000, "max": 2000000 },
      { "name": "delivery_date", "type": "date", "required": false, "help": "AAAA-MM-DD o AAAA-MM" },
      { "name": "delivery_date_status", "type": "enum", "required": false, "enum": ["confirmada", "estimada", "desconocida"] },
      { "name": "sale_stage", "type": "enum", "required": false, "enum": ["en_blanco", "en_verde", "futura", "pronta_entrega", "entrega_inmediata"], "help": "Etiqueta del portal. Sin fecha de entrega, el plan supone un plazo por etapa (editable en Configuración)." },
      { "name": "immediate_delivery_verified", "type": "bool", "required": false, "help": "Solo 'si' cuando hay recepción final/entrega comprobada." },
      { "name": "available_stock_verified", "type": "bool", "required": false, "help": "Solo 'si' cuando la unidad figura disponible en la fuente en la fecha observada." },
      { "name": "short_term_rental_status", "type": "enum", "required": false, "enum": ["permitido_verificado", "no_permitido_verificado", "por_verificar", "condicionado"] },
      { "name": "publication_url", "type": "url", "required": false },
      { "name": "brochure_url", "type": "url", "required": false },
      { "name": "data_observed_at", "type": "date", "required": true, "help": "Fecha en que se observó el precio/stock en la fuente." },
      { "name": "evidence_notes", "type": "string", "required": false },
      { "name": "is_demo", "type": "bool", "required": false, "help": "Marcar 'si' solo para datos ficticios de prueba." }
    ]
  },
  "rentals": {
    "group_by": null,
    "columns": [
      { "name": "listing_id", "type": "string", "required": true },
      { "name": "source", "type": "string", "required": true, "help": "Portal o corredor de origen. Solo avisos obtenidos con autorización o recopilados a mano." },
      { "name": "url", "type": "url", "required": false },
      { "name": "address", "type": "string", "required": false },
      { "name": "commune", "type": "string", "required": true },
      { "name": "latitude", "type": "number", "required": false, "min": -33.7, "max": -33.2 },
      { "name": "longitude", "type": "number", "required": false, "min": -70.9, "max": -70.4 },
      { "name": "geolocation_precision", "type": "enum", "required": false, "enum": ["exacta", "calle", "aproximada", "comuna"] },
      { "name": "price_clp", "type": "number", "required": true, "min": 50000, "max": 10000000, "help": "Precio PEDIDO en el aviso (no contrato cerrado)." },
      { "name": "common_expenses_clp", "type": "number", "required": false, "min": 0, "max": 2000000 },
      { "name": "common_expenses_included", "type": "bool", "required": false },
      { "name": "bedrooms", "type": "integer", "required": true, "min": 0, "max": 6 },
      { "name": "bathrooms", "type": "number", "required": false, "min": 0, "max": 6 },
      { "name": "useful_area_m2", "type": "number", "required": false, "min": 12, "max": 400 },
      { "name": "furnished", "type": "bool", "required": false },
      { "name": "parking", "type": "bool", "required": false },
      { "name": "building_year", "type": "integer", "required": false, "min": 1900, "max": 2035 },
      { "name": "published_at", "type": "date", "required": false },
      { "name": "observed_at", "type": "date", "required": true },
      { "name": "notes", "type": "string", "required": false },
      { "name": "is_demo", "type": "bool", "required": false }
    ]
  }
}
