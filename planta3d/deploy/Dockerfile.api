# API + interfaz web compilada. No incluye el motor de reconstrucción (vive en el trabajador).
FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY deploy/certs/ /usr/local/share/ca-certificates/
RUN (ls /usr/local/share/ca-certificates/*.crt >/dev/null 2>&1 && cat /usr/local/share/ca-certificates/*.crt > /tmp/extra-ca.pem) || touch /tmp/extra-ca.pem
ENV NODE_EXTRA_CA_CERTS=/tmp/extra-ca.pem
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY deploy/certs/ /usr/local/share/ca-certificates/
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates libgomp1 curl \
    && update-ca-certificates && rm -rf /var/lib/apt/lists/*
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt PIP_CERT=/etc/ssl/certs/ca-certificates.crt
WORKDIR /app/backend
COPY backend/requirements.lock ./
RUN python3 -m venv /venv && /venv/bin/pip install --no-cache-dir -r requirements.lock
COPY backend/ ./
COPY --from=web /web/dist /app/frontend/dist
RUN useradd -r -u 10001 planta3d && mkdir -p /data && chown planta3d /data
USER planta3d
ENV PATH=/venv/bin:$PATH P3D_DATA_DIR=/data
EXPOSE 8000
HEALTHCHECK CMD curl -sf http://127.0.0.1:8000/api/health || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
