# Copia a deploy/.env y completa. Nunca subas .env al repositorio.
P3D_DB_PASSWORD=
P3D_SECRET_KEY=
P3D_BOOTSTRAP_ADMIN_EMAIL=admin@planta3d.local
P3D_BOOTSTRAP_ADMIN_PASSWORD=
P3D_APP_NAME=Planta 3D
# Para abrir la app desde el teléfono en la misma red Wi-Fi: P3D_BIND=0.0.0.0 y entra a http://<IP-del-PC>:8000
# (solo en una red de confianza; para uso compartido pon HTTPS delante).
P3D_BIND=127.0.0.1
