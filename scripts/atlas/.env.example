# Variables opcionales del pipeline de Atlas (en GitHub van como Secrets / Variables
# del repositorio; en local: `set -a; source scripts/atlas/.env; set +a`).
# Nunca subas un .env con valores reales.

# UF por API oficial de la CMF (gratis: https://api.cmfchile.cl/). Sin ella se usa el SII.
CMF_API_KEY=

# Digest semanal por correo (opcional). Ej. Gmail: smtp.gmail.com / 587 / contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# URL pública de la app (enlace en el correo). Variable, no secreto.
ATLAS_URL=https://mickaxxx.github.io/cosas-de-ia/atlas/
